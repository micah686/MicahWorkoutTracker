{
  "name": "gymtracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs && node scripts/check-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "convert": "python3 scripts/convert_workbook.py",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "lucide-react": "0.546.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.10",
    "@types/node": "22.19.15"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
